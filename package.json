{
  "name": "roll-with-me",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:offline": "node --experimental-strip-types scripts/verify-offline.mjs",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "staff:create": "tsx --env-file=.env.local scripts/staff.ts",
    "retention:review": "tsx --env-file=.env.local scripts/retention.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "cloudinary": "^2.7.0",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.19.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
