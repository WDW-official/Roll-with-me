# Public previews work without external services. Demo forms never store sensitive data.
DEMO_MODE=true
APP_URL=http://localhost:3000
# Required for live mode. Use a replica set (Atlas) for atomic bookings.
MONGODB_URI=
MONGODB_DB=rwm
# openssl rand -hex 32 (separate values)
SESSION_SECRET=
DATA_ENCRYPTION_KEY=
EXPORT_SIGNING_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Checkout is intentionally disabled until the provider, stock, shipping and refund flow are ready.
CHECKOUT_ENABLED=false
# Keep intake closed until a named trained lead, rota, escalation and retention process exist.
INTAKE_ENABLED=false
SAFEGUARDING_CONTACT_URL=
# Only publish an official mailbox and staffed hours that actually exist.
# Email ingestion/delivery is not connected; staff must operate the inbox and triage process.
SUPPORT_EMAIL=
SUPPORT_HOURS=
